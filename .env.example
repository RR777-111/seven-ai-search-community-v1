# Optional local overrides; the default install needs no .env. Do not add credentials.
WEB_PORT=3000
# Optional override. Leave empty to use the bundled PanSou service.
PANSOU_BASE_URL=
# Optional authorized HTTP(S)/SOCKS5 proxy if public search sites are blocked.
# Use a container-reachable address; never commit proxy credentials.
PANSOU_PROXY=
# Only if 10.200.249.0/24 conflicts with an existing network; verify an unused subnet first.
# COMMUNITY_SUBNET=10.200.249.0/24
